{
  "manifest_version": 3,
  "name": "Chrome Workspaces",
  "version": "0.1.0",
  "description": "A terminal per Chrome window, in the side panel.",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Chrome Workspaces"
  },
  "commands": {
    "_execute_action": {
      "description": "Open the workspace panel"
    },
    "next-workspace": {
      "description": "Next workspace"
    },
    "prev-workspace": {
      "description": "Previous workspace"
    }
  },
  "key": ""
}
