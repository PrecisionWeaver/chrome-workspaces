{
  "name": "chrome-workspaces",
  "version": "0.11.10",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "helper": "tsx helper/src/main.ts",
    "gen-key": "tsx scripts/gen-key.ts",
    "install-app": "tsx scripts/install.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "uninstall": "tsx scripts/uninstall.ts",
    "build:extension": "tsx scripts/build-extension.ts",
    "release": "tsx scripts/release.ts",
    "agent:start": "launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.chrome-workspaces.helper.plist",
    "agent:stop": "launchctl bootout gui/$(id -u)/com.chrome-workspaces.helper",
    "agent:restart": "launchctl kickstart -k gui/$(id -u)/com.chrome-workspaces.helper",
    "agent:status": "launchctl print gui/$(id -u)/com.chrome-workspaces.helper | grep -E 'state|pid|last exit'"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
